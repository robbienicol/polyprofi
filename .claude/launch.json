{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo (all platforms)",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "start"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "Expo (iOS)",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "ios"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "Expo (Android)",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "android"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "Expo (Web)",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "web"
      ],
      "port": 8081,
      "autoPort": false
    },
    {
      "name": "Expo (Web 8082)",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082,
      "autoPort": false
    },
    {
      "name": "Expo (Web 8090)",
      "runtimeExecutable": "bunx",
