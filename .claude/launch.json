        "8090"
      ],
      "port": 8090,
      "autoPort": false
    },
    {
      "name": "Expo (Web 8091)",
      "runtimeExecutable": "bunx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8091"
      ],
      "port": 8091,
      "autoPort": false
    }
  ]
